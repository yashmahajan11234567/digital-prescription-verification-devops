# RxVerify Environment Configuration
# Copy this file to .env and customize values for your environment
# DO NOT commit .env with real secrets to version control

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
TESTING=0

# Database Configuration
# SQLite (default for development/testing)
# DATABASE_URL=sqlite:///instance/prescriptions.db

# PostgreSQL (for Docker/production)
POSTGRES_DB=rxverify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}