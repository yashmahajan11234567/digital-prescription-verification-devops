[web]
# Copy this file to inventory.ini and replace the IP with your EC2 instance public IP.
# Obtain the IP from: terraform output -raw instance_public_ip
YOUR_EC2_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/your-key.pem ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'

# Alternatively, use the Terraform-generated inventory script:
# python ansible/generate_inventory.py --tf-output-dir ../terraform > inventory.ini
